{
  "name": "oxygen-metrics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "res:build": "rescript",
    "res:clean": "rescript clean",
    "res:dev": "rescript watch",
    "dev": "vite",
    "build": "rescript && vite build",
    "build:lib": "rescript && vite build --config vite.lib.config.js",
    "build:all": "rescript && vite build && vite build --config vite.lib.config.js",
    "bundle": "rescript && vite build --config vite.lib.config.js && node scripts/copy-bundle.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@fontsource/roboto": "^5.3.0",
    "@rescript/react": "^0.13.1",
    "framer-motion": "^11.3.28",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rescript": "12.3.0"
  },
  "devDependencies": {
    "@mununki/ppx-spice": "^0.5.0",
    "@preact/signals-core": "^1.6.0",
    "@preact/signals-react": "^2.0.1",
    "@vitejs/plugin-react": "^4.2.1",
    "apexcharts": "^3.49.0",
    "autoprefixer": "^10.4.15",
    "postcss": "^8.4.28",
    "react-apexcharts": "^1.4.1",
    "react-icons": "^5.2.1",
    "tailwindcss": "^3.3.3",
    "vite": "^5.0.6"
  }
}