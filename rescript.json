{
  "name": "oxygen-metrics",
  "sources": [
    {
      "dir": "src",
      "subdirs": true
    }
  ],
  "package-specs": [
    {
      "module": "esmodule",
      "in-source": true
    }
  ],
  "suffix": ".res.mjs",
  "bs-dependencies": [
    "@rescript/core",
    "@rescript/react",
    "@rescriptbr/react-query",
    "@glennsl/rescript-fetch",
    "@greenlabs/ppx-spice"
  ],
  "ppx-flags": [
    ["@greenlabs/ppx-spice/ppx", "-uncurried"]
  ],
  "bsc-flags": [
    "-open RescriptCore"
  ],
  "jsx": {
    "version": 4
  }
}